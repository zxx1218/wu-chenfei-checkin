# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=wcf_daily_life
DB_PORT=3306

# 服务器配置
PORT=20010
NODE_ENV=development

# MinIO配置（用于视频上传）
MINIO_ENDPOINT=cheerout.cn:19000
MINIO_BUCKET=wcf-doi-video
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_USE_SSL=false

# Bark推送配置
VITE_BARK_PUSH_ENABLED=true
VITE_BARK_PUSH_URL=https://api.day.app/push
VITE_BARK_JUMP_URL=http://cheerout.cn:40001
VITE_BARK_KEY_ZXX=your_bark_key_zxx
VITE_BARK_KEY_XIAOFEI=your_bark_key_xiaofei
# 添加新的设备Key
# VITE_BARK_KEY_NEWUSER=new_device_key_here

# 和风天气API配置（从 https://console.qweather.com/ 获取）
# 免费版每日1000次调用，完全满足个人使用需求
VITE_WEATHER_API_KEY=your_weather_api_key

# 前端API基础URL（生产环境使用服务器域名）
VITE_API_BASE_URL=http://cheerout.cn:20010/api

# 本地开发时可复制此行到 .env.local 并修改为 localhost
# VITE_API_BASE_URL=http://localhost:20010/api
